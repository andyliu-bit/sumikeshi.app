# 公開前に必ず設定する。未設定のまま公開すると、プライバシーポリシーと
# お問い合わせ先に「（設定してください）」が表示された状態で出てしまう。

# 独自ドメイン。sitemap / robots / OGP / metadataBase が参照する
NEXT_PUBLIC_SITE_URL=https://example.com

# 事業者情報。プライバシーポリシーの連絡先として表示される。
# 課金を開始する場合は、特定商取引法に基づく表記の法定記載事項にもなる。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
NEXT_PUBLIC_OPERATOR_PHONE=

# 買い切りライセンスの購入ページ（Gumroad / BOOTH / Lemon Squeezy の商品 URL）
# 未設定なら画面に「販売準備中」と表示される
NEXT_PUBLIC_PURCHASE_URL=
